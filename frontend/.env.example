# Frontend settings. Next.js only reads env files from this folder.
# Copy to frontend/.env.local (git-ignored).

# Where /api/* is proxied to (next.config.ts rewrites). Default: http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# 1 = replay the designer's sample scenarios instead of calling the backend (UI work without the backend).
NEXT_PUBLIC_SCAN_MOCK=0
